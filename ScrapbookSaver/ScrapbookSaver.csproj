<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ScrapbookSaver</AssemblyName>
    <Version>1.3.0</Version>
    <ApplicationIcon>../assets/scrapbook.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="../assets/scrapbook.ico" LogicalName="Scrapbook.Icon" />
    <EmbeddedResource Include="../assets/scrapbook.png" LogicalName="Scrapbook.Artwork" />
  </ItemGroup>
</Project>
